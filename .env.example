# Copy to .env in this directory. .env is gitignored.
# Values already set in your shell take precedence.

# GitHub
# RELEASE_OPERATOR_GITHUB_TOKEN=
# RELEASE_OPERATOR_GITHUB_ORG=
# After setting those: npm run cli -- github sync-repos

# Jira 3LO (OAuth app from the Atlassian developer console)
# RELEASE_OPERATOR_JIRA_OAUTH_CLIENT_ID=
# RELEASE_OPERATOR_JIRA_OAUTH_CLIENT_SECRET=
# RELEASE_OPERATOR_JIRA_SITE=https://your-site.atlassian.net
# RELEASE_OPERATOR_JIRA_CLOUD_ID=
# RELEASE_OPERATOR_JIRA_PROJECT_KEY=
# RELEASE_OPERATOR_JIRA_ISSUE_TYPE=Change
# PCM Change screen fields (risk, approvers, implementation plan = release PR URL,
# rollback plan = last Netlify production/main deploy for the repo's US/MX sites,
# affected services from create or repo name).
# NETLIFY_AUTH_TOKEN=
# Planned start/end are prompted on `create` (or --planned-start / --planned-end).
# Naive times like "2026-10-06 20:00" are America/Chicago wall clock (Jira PCM).
# RELEASE_OPERATOR_TZ=America/Chicago
# Required by some projects (this error: "Please assign an EPIC before creating"):
# RELEASE_OPERATOR_JIRA_PARENT_KEY=PCM-123
# Extra Jira fields as a JSON object (Epic Link custom field, labels, etc.):
# RELEASE_OPERATOR_JIRA_EXTRA_FIELDS={"customfield_10014":"PCM-123"}

# Jira API-token MCP fallback
# RELEASE_OPERATOR_JIRA_EMAIL=
# RELEASE_OPERATOR_JIRA_TOKEN=

# Slack bot (chat.postMessage + conversations.replies). Invite the bot to the channel.
# RELEASE_OPERATOR_SLACK_BOT_TOKEN=
# RELEASE_OPERATOR_SLACK_CHANNEL=C0123456789

# Optional paths / servers
# RELEASE_OPERATOR_DB=./release-operator.db
# RELEASE_OPERATOR_WORKFLOW=./config/pipeline.yaml
# RELEASE_OPERATOR_MLX_URL=http://127.0.0.1:8081
# Must match the Atlassian app Callback URL (8080 is for jira login, not mlx):
# RELEASE_OPERATOR_JIRA_OAUTH_REDIRECT_URI=http://localhost:8080/callback
